# Control flow \'97 note the colon and indentation, no parens needed\
if age >= 18:\
\'a0 \'a0 print("adult")\
elif age >= 13:\
\'a0 \'a0 print("teen")\
else:\
\'a0 \'a0 print("child")\
# Loops\
for i in range(5): \'a0 \'a0 \'a0 # like Swift's for i in 0..<5\
\'a0 \'a0 print(i)\
